# ========================================================
# TRANSJAP — Variáveis de Ambiente do Sistema de Horímetro
# ========================================================

# Servidor & Porta
PORT=3000
NODE_ENV=production

# Banco de Dados PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=transjap_horimetro
DB_USER=transjap_admin
DB_PASSWORD=sua_senha_segura_aqui
DATABASE_URL=postgresql://transjap_admin:sua_senha_segura_aqui@localhost:5432/transjap_horimetro

# Armazenamento de Fotos (Bucket S3-Compatível: AWS S3, Cloudflare R2 ou MinIO)
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_BUCKET=transjap-fotos-horimetros
S3_REGION=us-east-1
S3_ACCESS_KEY=seu_access_key_aqui
S3_SECRET_KEY=seu_secret_key_aqui

# Autenticação Administrativa
ADMIN_JWT_SECRET=gere_uma_chave_aleatoria_longa_aqui
ADMIN_SESSION_COOKIE_NAME=transjap_admin_session

# URL Base do Aplicativo
APP_URL=https://horimetro.transjap.com.br
